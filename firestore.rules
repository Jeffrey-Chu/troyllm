rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['member', 'officer'];
    }

    // Only the Firebase project administrator can assign the officer role.
    function officer() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'officer';
    }

    function validId(id) {
      return id.matches('^[A-Za-z0-9_-]{1,80}$');
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || officer());
      allow list: if officer();
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.email is string
        && request.resource.data.keys().hasAll(['role', 'email', 'displayName', 'joinedAt'])
        && request.resource.data.keys().hasOnly(['role', 'email', 'displayName', 'joinedAt'])
        && request.resource.data.role == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.joinedAt == request.time;
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100)
        || (officer()
          && resource.data.role == 'pending'
          && request.resource.data.role == 'member'
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['role', 'approvedBy', 'approvedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'approvedBy', 'approvedAt'])
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.approvedAt == request.time);
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if activeMember();
      allow create: if officer() && validId(activityId)
        && request.resource.data.keys().hasAll(['kind', 'title', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['kind', 'title', 'createdBy', 'createdAt'])
        && request.resource.data.kind in ['meeting', 'assignment']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Exactly one award per activity and member; the document ID is deterministic.
    match /awards/{awardId} {
      allow get, list: if activeMember()
        && (officer() || resource.data.memberUid == request.auth.uid);
      allow create: if officer()
        && request.resource.data.keys().hasAll(['activityId', 'memberUid', 'kind', 'points', 'awardedBy', 'awardedAt'])
        && request.resource.data.keys().hasOnly(['activityId', 'memberUid', 'kind', 'points', 'awardedBy', 'awardedAt'])
        && request.resource.data.activityId is string
        && validId(request.resource.data.activityId)
        && request.resource.data.memberUid is string
        && awardId == request.resource.data.activityId + '_' + request.resource.data.memberUid
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberUid))
        && get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.role in ['member', 'officer']
        && exists(/databases/$(database)/documents/activities/$(request.resource.data.activityId))
        && request.resource.data.kind == get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data.kind
        && request.resource.data.points == 5
        && request.resource.data.awardedBy == request.auth.uid
        && request.resource.data.awardedAt == request.time;
      allow update, delete: if false;
    }

    // A mistaken award can be reversed once; neither record can be edited or erased.
    match /reversals/{awardId} {
      allow get, list: if activeMember()
        && (officer() || resource.data.memberUid == request.auth.uid);
      allow create: if officer()
        && exists(/databases/$(database)/documents/awards/$(awardId))
        && request.resource.data.keys().hasAll(['memberUid', 'points', 'reason', 'reversedBy', 'reversedAt'])
        && request.resource.data.keys().hasOnly(['memberUid', 'points', 'reason', 'reversedBy', 'reversedAt'])
        && request.resource.data.memberUid == get(/databases/$(database)/documents/awards/$(awardId)).data.memberUid
        && request.resource.data.points == -5
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 200
        && request.resource.data.reversedBy == request.auth.uid
        && request.resource.data.reversedAt == request.time;
      allow update, delete: if false;
    }
      // ===== Club websites (club-sites/) =====
    // Each club site keeps its data under /sites/{site}. Nothing here touches the LLM club paths above.
    match /sites/{site} {
      function googleUser() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email is string
          && request.auth.token.email_verified == true;
      }
      // Admins are per site and can only be added by a project owner (scripts/grant-site-admin.mjs).
      function siteAdmin() {
        return googleUser()
          && site in ['vsa', 'tll', 'superdw', 'carclub']
          && exists(/databases/$(database)/documents/sites/$(site)/admins/$(request.auth.uid));
      }
      function d() { return request.resource.data; }
      function exact(keys) { return d().keys().hasAll(keys) && d().keys().hasOnly(keys); }
      function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
      function meetingId(id) { return id.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'); }

      allow read, write: if false;

      match /admins/{uid} {
        allow get: if googleUser() && request.auth.uid == uid;
        allow list, write: if false;
      }

      // ---- VSA: meetings, word of the day, check-ins, member profiles ----
      // Public: when check-in is open. The word itself lives in meetingWords (admins only).
      match /meetings/{meeting} {
        allow read: if site == 'vsa';
        allow create, update: if site == 'vsa' && siteAdmin() && meetingId(meeting)
          && exact(['opensAt', 'closesAt', 'setBy'])
          && d().opensAt == request.time
          && d().closesAt is timestamp
          && d().closesAt > request.time
          && d().closesAt <= request.time + duration.value(12, 'h')
          && d().setBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/sites/vsa/meetingWords/$(meeting)).data.word is string;
        allow delete: if false;
      }
      match /meetingWords/{meeting} {
        allow read: if site == 'vsa' && siteAdmin();
        allow create, update: if site == 'vsa' && siteAdmin() && meetingId(meeting)
          && exact(['word'])
          && str(d().word, 2, 30)
          && d().word.matches('^[a-z0-9 ]+$')
          && getAfter(/databases/$(database)/documents/sites/vsa/meetings/$(meeting)).data.opensAt == request.time;
        allow delete: if false;
      }
      match /checkins/{checkinId} {
        allow get: if site == 'vsa' && googleUser()
          && (resource.data.uid == request.auth.uid || siteAdmin());
        allow list: if site == 'vsa' && googleUser()
          && (resource.data.uid == request.auth.uid || siteAdmin());
        allow create: if site == 'vsa' && googleUser()
          && exact(['meeting', 'uid', 'email', 'name', 'grade', 'word', 'at'])
          && d().uid == request.auth.uid
          && d().email == request.auth.token.email
          && meetingId(d().meeting)
          && checkinId == d().meeting + '_' + request.auth.uid
          && str(d().name, 1, 60)
          && d().grade in ['9', '10', '11', '12']
          && d().at == request.time
          && exists(/databases/$(database)/documents/sites/vsa/meetings/$(d().meeting))
          && request.time >= get(/databases/$(database)/documents/sites/vsa/meetings/$(d().meeting)).data.opensAt
          && request.time < get(/databases/$(database)/documents/sites/vsa/meetings/$(d().meeting)).data.closesAt
          && d().word == get(/databases/$(database)/documents/sites/vsa/meetingWords/$(d().meeting)).data.word;
        allow update, delete: if false;
      }
      match /members/{uid} {
        allow get: if site == 'vsa' && googleUser() && (request.auth.uid == uid || siteAdmin());
        allow list: if site == 'vsa' && siteAdmin();
        allow create, update: if site == 'vsa' && googleUser() && request.auth.uid == uid
          && exact(['email', 'name', 'grade', 'ig', 'interests', 'joinedAt', 'updatedAt'])
          && d().email == request.auth.token.email
          && str(d().name, 1, 60)
          && d().grade in ['9', '10', '11', '12']
          && str(d().ig, 0, 31)
          && d().ig.matches('^@?[A-Za-z0-9._]*$')
          && d().interests is list
          && d().interests.size() <= 5
          && d().interests.hasOnly(['meet', 'dance', 'lion', 'food', 'officer'])
          && d().updatedAt == request.time
          && (resource == null ? d().joinedAt == request.time : d().joinedAt == resource.data.joinedAt);
        allow delete: if false;
      }

      // ---- Troy Learning League: newsletter, one per Google account ----
      match /subscribers/{uid} {
        allow get: if site == 'tll' && googleUser() && (request.auth.uid == uid || siteAdmin());
        allow list: if site == 'tll' && siteAdmin();
        allow create: if site == 'tll' && googleUser() && request.auth.uid == uid
          && exact(['email', 'name', 'at'])
          && d().email == request.auth.token.email
          && str(d().name, 0, 100)
          && d().at == request.time;
        allow update, delete: if false;
      }

      // ---- SUPER DW: order requests (no payment), 1 per 2 min, 50 per account ----
      // The client writes orderMeta/{uid} and orders/{uid}_{n} in one batch.
      match /orderMeta/{uid} {
        allow get: if site == 'superdw' && googleUser() && request.auth.uid == uid;
        allow create: if site == 'superdw' && googleUser() && request.auth.uid == uid
          && exact(['count', 'last'])
          && d().count == 1
          && d().last == request.time
          && existsAfter(/databases/$(database)/documents/sites/superdw/orders/$(uid + '_1'));
        allow update: if site == 'superdw' && googleUser() && request.auth.uid == uid
          && exact(['count', 'last'])
          && d().count == resource.data.count + 1
          && d().count <= 50
          && d().last == request.time
          && request.time > resource.data.last + duration.value(2, 'm')
          && existsAfter(/databases/$(database)/documents/sites/superdw/orders/$(uid + '_' + string(d().count)));
        allow delete: if false;
      }
      match /orders/{orderId} {
        function item(i) {
          return d().items[i] is map
            && d().items[i].keys().hasOnly(['name', 'detail', 'price'])
            && str(d().items[i].name, 1, 80)
            && str(d().items[i].detail, 0, 160)
            && d().items[i].price is number
            && d().items[i].price >= 0 && d().items[i].price <= 1000;
        }
        allow get: if site == 'superdw' && googleUser()
          && (resource.data.uid == request.auth.uid || siteAdmin());
        allow list: if site == 'superdw' && siteAdmin();
        allow create: if site == 'superdw' && googleUser()
          && exact(['uid', 'email', 'name', 'city', 'intent', 'items', 'total', 'status', 'at'])
          && d().uid == request.auth.uid
          && d().email == request.auth.token.email
          && str(d().name, 1, 80)
          && str(d().city, 1, 60)
          && str(d().intent, 0, 140)
          && d().items is list
          && d().items.size() >= 1 && d().items.size() <= 10
          && item(0)
          && (d().items.size() < 2 || item(1))
          && (d().items.size() < 3 || item(2))
          && (d().items.size() < 4 || item(3))
          && (d().items.size() < 5 || item(4))
          && (d().items.size() < 6 || item(5))
          && (d().items.size() < 7 || item(6))
          && (d().items.size() < 8 || item(7))
          && (d().items.size() < 9 || item(8))
          && (d().items.size() < 10 || item(9))
          && d().total is number && d().total >= 0 && d().total <= 5000
          && d().status == 'new'
          && d().at == request.time
          && getAfter(/databases/$(database)/documents/sites/superdw/orderMeta/$(request.auth.uid)).data.last == request.time
          && orderId == request.auth.uid + '_' + string(getAfter(/databases/$(database)/documents/sites/superdw/orderMeta/$(request.auth.uid)).data.count);
        // Only the shop owner (site admin) can change status, and nothing else.
        allow update: if site == 'superdw' && siteAdmin()
          && d().diff(resource.data).affectedKeys().hasOnly(['status'])
          && d().status in ['new', 'confirmed', 'paid', 'ready', 'done', 'cancelled'];
        allow delete: if false;
      }

      // ---- Troy Car Club: M4 vs M5 poll, one vote per account ----
      match /votes/{uid} {
        allow read: if site == 'carclub';
        allow create: if site == 'carclub' && googleUser() && request.auth.uid == uid
          && exact(['choice', 'at'])
          && d().choice in ['M4', 'M5']
          && d().at == request.time;
        allow update: if site == 'carclub' && googleUser() && request.auth.uid == uid
          && exact(['choice', 'at'])
          && d().choice in ['M4', 'M5']
          && d().at == request.time
          && request.time > resource.data.at + duration.value(30, 's');
        allow delete: if false;
      }
    }
  }
}
